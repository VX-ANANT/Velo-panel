{
  "rules": {
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && !root.child('banned_users').child(auth.uid).exists()"
      }
    },
    "userProfiles": {
      ".read": "auth != null",
      ".write": "auth != null && !root.child('banned_users').child(auth.uid).exists()"
    },
    "players": {
      ".read": "auth != null",
      ".write": "auth != null && !root.child('banned_users').child(auth.uid).exists()"
    },
    "admins": {
      ".read": "auth != null",
      ".write": "auth != null && !root.child('banned_users').child(auth.uid).exists()",
      "$adminUid": {
        ".read": "auth != null",
        ".write": "auth != null && !root.child('banned_users').child(auth.uid).exists()"
      }
    },
    "banned_users": {
      ".read": "auth != null",
      ".write": "auth != null && !root.child('banned_users').child(auth.uid).exists()"
    },
    "support_tickets": {
      ".read": "auth != null",
      ".write": "auth != null && !root.child('banned_users').child(auth.uid).exists()",
      "$ticketId": {
        ".read": "auth != null",
        ".write": "auth != null && !root.child('banned_users').child(auth.uid).exists()"
      }
    },
    "complaints": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "chatbot_complaints": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "payout_requests": {
      ".read": "auth != null",
      ".write": "auth != null && !root.child('banned_users').child(auth.uid).exists()",
      "$requestId": {
        ".read": "auth != null",
        ".write": "auth != null && !root.child('banned_users').child(auth.uid).exists()"
      }
    },
    "withdrawals": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "wallet_transactions": {
      ".read": "auth != null",
      ".write": "auth != null && !root.child('banned_users').child(auth.uid).exists()",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && !root.child('banned_users').child(auth.uid).exists()",
        "$txId": {
          ".validate": "newData.hasChildren(['amount', 'type', 'timestamp', 'status'])",
          "amount": { ".validate": "newData.isNumber()" },
          "type": { ".validate": "newData.val() === 'deposit' || newData.val() === 'withdrawal' || newData.val() === 'entry_fee' || newData.val() === 'prize_payout' || newData.val() === 'mission_reward' || newData.val() === 'referral_bonus' || newData.val() === 'refund' || newData.val() === 'BONUS' || newData.val() === 'DEPOSIT' || newData.val() === 'WINNINGS'" },
          "timestamp": { ".validate": "newData.isNumber()" },
          "status": { ".validate": "newData.val() === 'pending' || newData.val() === 'completed' || newData.val() === 'failed' || newData.val() === 'rejected' || newData.val() === 'COMPLETED'" },
          "referenceId": { ".validate": "newData.isString()" },
          "description": { ".validate": "newData.isString() && newData.val().length <= 200" }
        }
      }
    },
    "tournaments": {
      ".read": "auth != null && !root.child('banned_users').child(auth.uid).exists()",
      ".write": "auth != null && !root.child('banned_users').child(auth.uid).exists()",
      "$tournamentId": {
        ".validate": "newData.hasChildren(['title', 'game'])",
        "title": { ".validate": "newData.isString()" },
        "game": { ".validate": "newData.isString()" },
        "category": { ".validate": "!newData.exists() || newData.isString()" },
        "format": { ".validate": "!newData.exists() || newData.isString()" },
        "map": { ".validate": "!newData.exists() || newData.isString()" },
        "fee": { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)" },
        "entryFee": { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)" },
        "prizePool": { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)" },
        "perKill": { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)" },
        "maxPlayers": { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() > 0)" },
        "registeredPlayers": { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)" },
        "slotsFilled": { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)" },
        "status": { ".validate": "!newData.exists() || newData.isString()" },
        "startTime": { ".validate": "!newData.exists() || newData.isNumber() || newData.isString()" },
        "scheduledTime": { ".validate": "!newData.exists() || newData.isNumber() || newData.isString()" },
        "rulesText": { ".validate": "!newData.exists() || newData.isString()" },
        "roomDetails": {
          ".read": "auth != null",
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['roomId', 'roomPassword'])",
          "roomId": { ".validate": "newData.isString()" },
          "roomPassword": { ".validate": "newData.isString()" }
        }
      }
    },
    "matches": {
      ".read": "auth != null",
      ".write": "auth != null && !root.child('banned_users').child(auth.uid).exists()"
    },
    "categories": {
      ".read": "auth != null",
      ".write": "auth != null && !root.child('banned_users').child(auth.uid).exists()"
    },
    "tournaments_by_category": {
      ".read": "auth != null",
      ".write": "auth != null && !root.child('banned_users').child(auth.uid).exists()"
    },
    "matches_by_category": {
      ".read": "auth != null",
      ".write": "auth != null && !root.child('banned_users').child(auth.uid).exists()"
    },
    "FreeFire": {
      ".read": "auth != null",
      ".write": "auth != null && !root.child('banned_users').child(auth.uid).exists()"
    },
    "games": {
      ".read": "auth != null",
      ".write": "auth != null && !root.child('banned_users').child(auth.uid).exists()"
    },
    "active_tournaments": {
      ".read": "auth != null",
      ".write": "auth != null && !root.child('banned_users').child(auth.uid).exists()"
    },
    "custom_rooms": {
      ".read": "auth != null",
      ".write": "auth != null && !root.child('banned_users').child(auth.uid).exists()"
    },
    "registrations": {
      "$tournamentId": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && ((auth.uid === $uid && !root.child('banned_users').child(auth.uid).exists() && !data.exists()) || (root.child('admins').child(auth.uid).child('active').val() === true) || auth.token.email === 'anantisback47@gmail.com')",
          ".validate": "newData.hasChildren(['userId', 'ign', 'gameId', 'registeredAt'])",
          "userId": { ".validate": "newData.val() === $uid" },
          "ign": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30" },
          "gameId": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30" },
          "teamName": { ".validate": "newData.isString() && newData.val().length <= 50" },
          "registeredAt": { ".validate": "newData.isNumber()" },
          "slotNumber": { ".validate": "newData.isNumber()" },
          "paymentTxId": { ".validate": "newData.isString()" }
        }
      }
    },
    "missions": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).child('active').val() === true || auth.token.email === 'anantisback47@gmail.com')",
        "$missionId": {
          ".write": "auth != null && auth.uid === $uid && !root.child('banned_users').child(auth.uid).exists()",
          ".validate": "newData.hasChildren(['id', 'title', 'rewardVt', 'isCompleted', 'isClaimed'])",
          "id": { ".validate": "newData.isString()" },
          "title": { ".validate": "newData.isString()" },
          "rewardVt": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "isCompleted": { ".validate": "newData.isBoolean()" },
          "isClaimed": { ".validate": "newData.isBoolean()" },
          "claimedAt": { ".validate": "newData.isNumber()" },
          "progress": { ".validate": "newData.isNumber()" }
        }
      }
    },
    "leaderboards": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('admins').child(auth.uid).child('active').val() === true || auth.token.email === 'anantisback47@gmail.com')",
      "$seasonId": {
        "$uid": {
          ".validate": "newData.hasChildren(['userName', 'score', 'rank'])",
          "userName": { ".validate": "newData.isString()" },
          "freeFireId": { ".validate": "newData.isString()" },
          "kills": { ".validate": "newData.isNumber()" },
          "wins": { ".validate": "newData.isNumber()" },
          "score": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "rank": { ".validate": "newData.isNumber() && newData.val() >= 1" },
          "updatedAt": { ".validate": "newData.isNumber()" }
        }
      }
    },
    "community_chat": {
      ".read": "auth != null && !root.child('banned_users').child(auth.uid).exists()",
      "$messageId": {
        ".write": "auth != null && ((!data.exists() && newData.child('senderUid').val() === auth.uid && !root.child('banned_users').child(auth.uid).exists()) || root.child('admins').child(auth.uid).child('active').val() === true || auth.token.email === 'anantisback47@gmail.com')",
        ".validate": "newData.hasChildren(['senderUid', 'senderName', 'message', 'timestamp'])",
        "senderUid": { ".validate": "newData.val() === auth.uid || root.child('admins').child(auth.uid).child('active').val() === true || auth.token.email === 'anantisback47@gmail.com'" },
        "senderName": { ".validate": "newData.isString() && newData.val().length <= 50" },
        "senderAvatar": { ".validate": "newData.isString()" },
        "message": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500" },
        "timestamp": { ".validate": "newData.isNumber()" },
        "isAnnouncement": { ".validate": "newData.isBoolean()" }
      }
    },
    "system_config": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('admins').child(auth.uid).child('role').val() === 'super_admin' || auth.token.email === 'anantisback47@gmail.com' || auth.token.email === 'velorixtest@gmail.com')",
      "maintenanceMode": { ".validate": "newData.isBoolean()" },
      "minWithdrawalAmount": { ".validate": "newData.isNumber() && newData.val() >= 1" },
      "announcementBanner": { ".validate": "newData.isString() && newData.val().length <= 300" },
      "appMinVersion": { ".validate": "newData.isString()" },
      "supportEmail": { ".validate": "newData.isString()" },
      "upiMerchantId": { ".validate": "newData.isString()" }
    },
    "campaigns": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('admins').child(auth.uid).child('active').val() === true || auth.token.email === 'anantisback47@gmail.com')"
    },
    "announcements": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('admins').child(auth.uid).child('active').val() === true || auth.token.email === 'anantisback47@gmail.com')"
    },
    "notifications": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('admins').child(auth.uid).child('active').val() === true || auth.token.email === 'anantisback47@gmail.com')"
    },
    "banners": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('admins').child(auth.uid).child('active').val() === true || auth.token.email === 'anantisback47@gmail.com')"
    },
    "tokens": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "audit_logs": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).child('role').val() === 'super_admin' || auth.token.email === 'anantisback47@gmail.com')",
      ".write": "auth != null && (root.child('admins').child(auth.uid).child('active').val() === true || auth.token.email === 'anantisback47@gmail.com')",
      "$logId": {
        ".validate": "newData.hasChildren(['action', 'performedBy', 'timestamp'])",
        "action": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "performedBy": { ".validate": "newData.isString()" },
        "targetUid": { ".validate": "newData.isString()" },
        "details": { ".validate": "newData.isString() && newData.val().length <= 500" },
        "timestamp": { ".validate": "newData.isNumber()" }
      }
    }
  }
}
