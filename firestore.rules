rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'anantisback47@gmail.com' ||
        request.auth.token.email == 'velorixtest@gmail.com' ||
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Tournaments, Matches, and Category Trees
    match /tournaments/{tournamentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /matches/{matchId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /active_tournaments/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /all_tournaments/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /categories/{category}/{subCollection}/{documentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /tournaments_by_category/{category}/{subCollection}/{documentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Registrations & Custom Rooms
    match /registrations/{tournamentId}/players/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /custom_rooms/{roomId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Users and Profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /userProfiles/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isAdmin();
    }

    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Support, Payouts, and Transactions
    match /support_tickets/{ticketId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /payout_requests/{requestId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /wallet_transactions/{userId}/transactions/{txId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }

    // System configurations & Announcements
    match /system_config/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /banners/{bannerId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
